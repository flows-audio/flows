{
  "$comment": "A scripted UI session run against every core build (native and WebAssembly). Strings starting with $ are resolved before each step: $snapshot.<path> reads the latest snapshot, $result.<label>.<path> a labelled step's result. waitFor 'ready' renders audio until the active revision compiled and installed.",
  "steps": [
    { "label": "initial", "method": "session.get", "params": {} },
    { "label": "new", "method": "document.new", "params": { "name": "Conformance" }, "waitFor": "ready" },
    { "label": "edit", "method": "document.apply", "params": {
        "documentId": "$snapshot.document.id", "baseRevision": "$snapshot.document.revision",
        "text": "# 音色 🎹 é\nimport standard as std\nfrom lib.osc import ClassicSine\nfrom lib.env import ClassicADSR\n\nInst.sigstream(std.event.keys.poly()) as key:\n    osc = ClassicSine.make()\n    env = ClassicADSR.make()\n    raw = osc(pitch: key.pitch, level: -12db)\n    amp = env(gate: key.gate, trigger: key.trigger, A: 5ms, D: 120ms, S: 0.65, R: 180ms)\n    observed = probe(raw)\n    energy = power(observed)\n    return raw * amp * key.velocity\n" },
      "waitFor": "ready" },
    { "label": "stale-edit", "method": "document.apply", "params": { "documentId": "$snapshot.document.id", "baseRevision": 1, "text": "stale" }, "expectError": "The document changed" },
    { "label": "probe", "method": "probe.set", "params": { "signals": ["raw", "energy"], "voice": "mixed", "projection": "mid", "documentId": "$snapshot.document.id" } },
    { "label": "listen", "method": "probe.listen", "params": { "signal": "raw", "enabled": true, "documentId": "$snapshot.document.id" } },
    { "label": "unlisten", "method": "probe.listen", "params": { "signal": "raw", "enabled": false, "documentId": "$snapshot.document.id" } },
    { "label": "note-on", "method": "keyboard.noteOn", "params": { "noteId": 7, "pitch": 60, "velocity": 0.8, "documentId": "$snapshot.document.id" } },
    { "label": "note-off", "method": "keyboard.noteOff", "params": { "noteId": 7, "pitch": 60, "documentId": "$snapshot.document.id" } },
    { "label": "export-macro", "method": "parameter.export", "params": { "slot": 1, "bindingId": "$snapshot.compile.parameters.0.id", "documentId": "$snapshot.document.id" } },
    { "label": "unexport-macro", "method": "parameter.unexport", "params": { "slot": 1, "documentId": "$snapshot.document.id" } },
    { "label": "tempo", "method": "transport.set", "params": { "bpm": 120 } },
    { "label": "bad-tempo", "method": "transport.set", "params": { "bpm": 999 }, "expectError": "Tempo must be between" },
    { "label": "preferences", "method": "preferences.set", "params": { "theme": "paper", "fontSize": 15, "showKeyboard": false } },
    { "label": "pattern", "method": "sequencer.set", "params": {
        "documentId": "$snapshot.document.id", "baseRevision": "$snapshot.sequencer.revision",
        "pattern": { "length": 16, "division": 16, "swing": 0.1, "direction": "pingpong", "root": 2, "scale": "minor", "transpose": -12,
          "metronome": { "mute": true, "division": 4, "volume": -12 },
          "rows": [{ "note": 50, "mute": false, "volume": -3, "steps": [
            { "active": true, "velocity": 0.9, "gate": 0.5 }, { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": true, "velocity": 0.7, "gate": 0.3 }, { "active": false, "velocity": 0.85, "gate": 0.6 },
            { "active": true, "velocity": 0.9, "gate": 0.5 }, { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": true, "velocity": 0.7, "gate": 0.3 }, { "active": false, "velocity": 0.85, "gate": 0.6 },
            { "active": true, "velocity": 0.9, "gate": 0.5 }, { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": true, "velocity": 0.7, "gate": 0.3 }, { "active": false, "velocity": 0.85, "gate": 0.6 },
            { "active": true, "velocity": 0.9, "gate": 0.5 }, { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": true, "velocity": 0.7, "gate": 0.3 }, { "active": false, "velocity": 0.85, "gate": 0.6 },
            { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": false, "velocity": 0.85, "gate": 0.6 },
            { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": false, "velocity": 0.85, "gate": 0.6 },
            { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": false, "velocity": 0.85, "gate": 0.6 },
            { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": false, "velocity": 0.85, "gate": 0.6 }, { "active": false, "velocity": 0.85, "gate": 0.6 }
          ] }] } } },
    { "label": "play", "method": "sequencer.play", "params": { "playing": true, "documentId": "$snapshot.document.id" } },
    { "label": "stop", "method": "sequencer.play", "params": { "playing": false, "documentId": "$snapshot.document.id" } },
    { "label": "undo", "method": "document.undo", "params": { "documentId": "$snapshot.document.id" }, "waitFor": "ready" },
    { "label": "redo", "method": "document.redo", "params": { "documentId": "$snapshot.document.id" }, "waitFor": "ready" },
    { "label": "recompile", "method": "compile", "params": { "documentId": "$snapshot.document.id", "revision": "$snapshot.document.revision" }, "waitFor": "ready" },
    { "label": "save", "method": "document.save", "params": { "documentId": "$snapshot.document.id" } },
    { "label": "rename", "method": "document.rename", "params": { "documentId": "$snapshot.document.id", "name": "Renamed instrument" } },
    { "label": "import", "method": "workspace.import", "params": { "folder": "examples", "name": "Dropped.flows",
        "data": "aW1wb3J0IHN0YW5kYXJkIGFzIHN0ZApmcm9tIGxpYi5vc2MgaW1wb3J0IENsYXNzaWNTaW5lCgpJbnN0LnNpZ3N0cmVhbShzdGQuZXZlbnQua2V5cy5wb2x5KCkpIGFzIGtleToKICAgIG9zYyA9IENsYXNzaWNTaW5lLm1ha2UoKQogICAgcmF3ID0gb3NjKHBpdGNoOiBrZXkucGl0Y2gsIGxldmVsOiAtMTJkYikKICAgIHJldHVybiByYXcgKiBrZXkuZ2F0ZSAqIGtleS52ZWxvY2l0eQo=" } },
    { "label": "open-import", "method": "document.open", "params": { "path": "$result.import.importedPath" }, "waitFor": "ready" },
    { "label": "activate-renamed", "method": "document.activate", "params": { "documentId": "examples/Renamed instrument.flows" }, "waitFor": "ready" },
    { "label": "close-dirty", "method": "document.close", "params": { "documentId": "$result.import.importedPath" } },
    { "label": "package", "method": "project.exportText", "params": {} },
    { "label": "reimport", "method": "project.importText", "params": { "text": "$result.package" }, "waitFor": "ready" },
    { "label": "close-reimport", "method": "document.close", "params": { "documentId": "$snapshot.document.id", "discard": true }, "waitFor": "ready" },
    { "label": "conversation", "method": "ai.conversations.create", "params": { "title": "Conformance" } },
    { "label": "conversation-list", "method": "ai.conversations.list", "params": {} },
    { "label": "model", "method": "ai.models.save", "params": { "name": "Local", "endpoint": "http://localhost:9/v1", "model": "local-test" } },
    { "label": "bad-model", "method": "ai.models.save", "params": { "endpoint": "http://remote.invalid/v1", "model": "x" }, "expectError": "Use an HTTPS URL" },
    { "label": "panic", "method": "keyboard.panic", "params": { "documentId": "$snapshot.document.id" } },
    { "label": "unknown", "method": "no.such.method", "params": {}, "expectError": "Unknown native method" },
    { "label": "final", "method": "session.get", "params": {} }
  ]
}
