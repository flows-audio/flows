# Private working notes (migration plan etc.) stay out of history.
REF_*

# Build output and tool caches.
build*/
.cache/
.DS_Store
__pycache__/

# Reproducible test output is generated locally.
test/output/
ui/node_modules/
ui/dist/
ui/dist-web/
ui/test-results/
ui/playwright-report/

# Local application/plugin release packages.
/dist/

# Personal workspace, credentials and local publication reports.
.env
.env.*
!.env.example
*.pem
*.key
.assistant-history.json
.recovery/
.sequencers/
.local/

# Optional local producer-vault link; never publish personal notes.
/producer
